generator client {
  provider = "prisma-client-js"
  output   = "../client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String    @id // Discord User ID
  username    String
  globalName  String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  cases             ModerationCase[]    @relation("UserCases")
  moderated         ModerationCase[]    @relation("ModeratorCases")
  warnings          Warning[]
  sessions          Session[]
  DashboardAuditLog DashboardAuditLog[]
  dmPromotion       UserDMPromotion?
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Guild {
  id          String   @id // Discord Guild ID
  name        String
  memberCount Int      @default(0)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings           GuildSetting?
  cases              ModerationCase[]
  warnings           Warning[]
  securityEvents     SecurityEvent[]
  raidEvents         RaidEvent[]
  memberSnapshots    MemberSnapshot[]
  messageActivity    MessageActivity[]
  rolePermissions    RoleCommandPermission[]
  rules              Rule[]
  DashboardAuditLog  DashboardAuditLog[]
  serverListing      ServerListing?
  featuredPromotions FeaturedPromotion[]
}

model GuildSetting {
  guildId String @id
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Security Toggles
  antiRaidEnabled    Boolean @default(false)
  antiNukeEnabled    Boolean @default(false)
  antiSpamEnabled    Boolean @default(false)
  antiMassMention    Boolean @default(false)
  antiWebhookAbuse   Boolean @default(false)
  scamDetection      Boolean @default(true)
  autoLockdown       Boolean @default(false)
  verificationSystem Boolean @default(false)
  publicListing      Boolean @default(false)

  // AI Moderation
  aiModerationEnabled Boolean @default(true)
  aiLogChannelId      String?
  aiActionThreshold   Int     @default(80) // 0-100 confidence

  // Channels
  modLogChannelId      String?
  securityLogChannelId String?

  // Role Configurations
  modRole       String?
  seniorModRole String?
  adminRole     String?
  mutedRole     String?

  prefix String @default("!")
}

model ModerationCase {
  id          Int       @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  type        String // BAN, KICK, TIMEOUT, WARN, UNWARN, PURGE, LOCK
  reason      String?
  duration    String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  guild     Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User  @relation("UserCases", fields: [userId], references: [id], onDelete: Cascade)
  moderator User  @relation("ModeratorCases", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
}

model Warning {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
}

model SecurityEvent {
  id          Int      @id @default(autoincrement())
  guildId     String
  type        String // SPAM, RAID_JOIN, NUKE_ATTEMPT, SCAM_LINK
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  description String
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([createdAt])
}

model RaidEvent {
  id        Int       @id @default(autoincrement())
  guildId   String
  status    String // ACTIVE, MITIGATED, RESOLVED
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model MemberSnapshot {
  id        Int      @id @default(autoincrement())
  guildId   String
  count     Int
  timestamp DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, timestamp])
}

model MessageActivity {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  count     Int      @default(1)
  timestamp DateTime @default(now()) // Stored by hour

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId, timestamp])
}

model BotStat {
  id          Int      @id @default(autoincrement())
  serverCount Int
  userCount   Int
  shardCount  Int
  updatedAt   DateTime @updatedAt
}

model BotStatHistory {
  id          Int      @id @default(autoincrement())
  serverCount Int
  userCount   Int
  shardCount  Int
  timestamp   DateTime @default(now())
}

model RoleCommandPermission {
  id        Int      @id @default(autoincrement())
  guildId   String
  roleId    String
  command   String
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId, command])
  @@index([guildId, command])
}

model Rule {
  id        Int      @id @default(autoincrement())
  guildId   String
  content   String
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model AfkStatus {
  userId    String   @id
  reason    String?
  startedAt DateTime @default(now())
}

model DashboardAuditLog {
  id          Int      @id @default(autoincrement())
  guildId     String
  actorUserId String
  action      String // e.g., "GRANTED_PERMISSION", "TOGGLED_SETTING"
  targetType  String? // e.g., "ROLE", "SETTING"
  targetId    String? // e.g., "1234567890", "antiRaidEnabled"
  metadata    Json? // Any extra contextual data
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([actorUserId])
}

model ServerListing {
  guildId     String   @id
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  description String?
  iconUrl     String?
  inviteUrl   String?
  category    String?
  tags        String[] @default([])
  language    String   @default("en")
  isPublic    Boolean  @default(false)
  views       Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic])
  @@index([category])
  @@index([language])
}

model FeaturedPromotion {
  id                 Int      @id @default(autoincrement())
  guildId            String
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  promotionType      String // FEATURED_PLACEMENT, DM_PROMOTION
  status             String // ACTIVE, PAUSED, EXPIRED
  startAt            DateTime @default(now())
  expiresAt          DateTime
  promotionalMessage String?
  impressions        Int      @default(0)
  clicks             Int      @default(0)
  dmSent             Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  approvedBy         String?

  @@index([guildId])
  @@index([status])
  @@index([expiresAt])
}

model UserDMPromotion {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastPromotionAt DateTime?
  optOut          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
